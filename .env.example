# Copy to .env and fill in. .env is gitignored.
#
# Local MySQL connection.
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_PORT=3306
MYSQL_DATABASE=fieldforce

# Signs the admin session JWT. Any non-empty string works locally.
SESSION_SECRET=dev-secret-local-only

# Google Workspace SMTP (use an app password, not the account password).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Field Force Monitor <your-email@example.com>

# Optional comma-separated security recipients. When set, every valid login
# OTP is sent to this list instead of the user's profile email.
OTP_RECIPIENTS=security-one@example.com,security-two@example.com

# ── WhatsApp notifications ───────────────────────────────────────────────────
# Login OTPs, password resets, and welcome messages can go out over WhatsApp as
# well as email. The preferred way to configure this is the WhatsApp Setup page
# in the admin dashboard (Notifications → WhatsApp Setup), which stores the
# credentials encrypted in the database and explains where each value comes
# from. The variables below are a fallback used only when no configuration has
# been saved there — handy for a first deploy or an unattended environment.
#
# Encrypts credentials saved from the dashboard. 64 hex characters. Shared with
# the GPS vendor credentials. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CREDENTIALS_ENCRYPTION_KEY=

# META_CLOUD (default) | TWILIO | CUSTOM
# WHATSAPP_PROVIDER=META_CLOUD
# WHATSAPP_ENABLED=true
# BOTH (default) | WHATSAPP_ONLY | EMAIL_ONLY
# WHATSAPP_CHANNEL_MODE=BOTH
# TEMPLATE (required by Meta for business-initiated messages) | TEXT
# WHATSAPP_MESSAGE_MODE=TEMPLATE
# Prefixed onto stored numbers that carry no country code.
# WHATSAPP_DEFAULT_COUNTRY_CODE=91
# WhatsApp equivalent of OTP_RECIPIENTS above.
# WHATSAPP_OTP_RECIPIENTS=+919876543210,+919812345678

# Meta WhatsApp Cloud API — developers.facebook.com → your app → WhatsApp
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v23.0

# Twilio WhatsApp — console.twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_MESSAGING_SERVICE_SID=

# Custom provider / BSP (Gupshup, WATI, AiSensy, 360dialog, in-house gateway).
# Placeholders available in the body template: {{to}} {{text}} {{from}} {{apiKey}}
# WHATSAPP_CUSTOM_ENDPOINT_URL=
# WHATSAPP_CUSTOM_API_KEY=
# WHATSAPP_CUSTOM_AUTH_HEADER_NAME=Authorization
# WHATSAPP_CUSTOM_AUTH_HEADER_VALUE=Bearer {{apiKey}}
# WHATSAPP_CUSTOM_SENDER_ID=
# WHATSAPP_CUSTOM_BODY_TEMPLATE=
# WHATSAPP_CUSTOM_CONTENT_TYPE=application/json

# Optional. Both dev scripts fall back to their own defaults when unset.
# Do NOT export PORT globally — api-server and fieldforce-admin both read it
# and would collide on the same port.
# API_PORT=7070
# FRONTEND_PORT=7075
# BASE_PATH=/
# API_PROXY_TARGET=http://localhost:7070

# ── Agent mobile app (artifacts/fieldforce-mobile) ───────────────────────────
# Set START_MOBILE=true to have `pnpm start` also launch the Expo dev server
# alongside the API and admin panel. Off by default so the normal backend
# workflow is unchanged.
# START_MOBILE=true
# MOBILE_PORT=8081
# With APP_URL configured, the root launcher serves the prebuilt mobile app at
# APP_URL/mobile-app so phones can use any network. Set MOBILE_TUNNEL=true only
# when you specifically need live Expo/Metro reloads through an Ngrok tunnel.
# MOBILE_TUNNEL=false

# Public origin the mobile app calls for /api/*. Expo's tunnel exposes the app
# bundle but not the local API port. In tunnel mode this falls back to APP_URL;
# set MOBILE_API_URL when the API uses a different public HTTPS origin.
# MOBILE_API_URL=https://mwmcrm.voicemeetme.net
# Public app/Expo URL encoded in the biker welcome-email QR code. When omitted,
# it defaults to APP_URL/mobile-app.
# MOBILE_APP_URL=https://mwmcrm.voicemeetme.net/mobile-app

# Enable HTTPS in the API server using certificates under the project ssl folder.
USE_HTTPS=false
SSL_KEY_PATH=ssl/privkey.pem
SSL_CERT_PATH=ssl/fullchain.pem

# Public deployment URLs. APP_URL is the canonical admin URL. CORS_ORIGIN is
# the comma-separated list of browser origins allowed to call the API. Native
# Android/iOS apps do not need to be listed because they send no Origin header.
#
# APP_URL is also the origin of the welcome and password-reset links sent by
# email. It is only used when NODE_ENV=production; local runs always link to
# http://localhost:$FRONTEND_PORT so development mail never points at the live
# site. The links are never built from the request Host header, which an
# attacker could set to redirect a reset link to their own domain.
APP_URL=https://mwmcrm.voicemeetme.net
CORS_ORIGIN=https://mwmcrm.voicemeetme.net

# Admin live-map provider: "leaflet" (OpenStreetMap, free, no API key — the
# default) or "google" (requires VITE_GOOGLE_MAPS_API_KEY below).
VITE_MAP_PROVIDER=leaflet

# Frontend (admin) Google Maps JS API key. Required only when
# VITE_MAP_PROVIDER=google; otherwise the map uses keyless Leaflet tiles.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Backend (api-server) Google Geocoding API key. When set, new addresses / visit
# stops are geocoded to real lat/lng; when unset the server falls back to random
# Delhi-NCR coordinates (dev stub).
# It also powers the hub-location search box (/api/geo/search) and the
# address lookup behind the map pin (/api/geo/reverse). Those two fall back to
# keyless OpenStreetMap Nominatim instead of the stub when no key is set.
GOOGLE_MAPS_SERVER_KEY=your-google-geocoding-api-key
